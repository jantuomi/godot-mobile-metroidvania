[sub_resource type="GDScript" id="GDScript_31h2m"]
script/source = "extends Sprite2D

var t: float = 0
const w: float = 5
const A: float = 1

var oscing = true

func _physics_process(delta: float) -> void:
	if oscing: t += delta
	offset.y = A * sin(w * t)

func _on_player_entered(_player: Player) -> void:
	oscing = false
	var dia = CinematicGotAbilities.new(self)
	get_parent().add_child(dia)

class CinematicGotAbilities extends Cinematic:
	@onready var player: Player = parent.get_node(\"Player\")
	@onready var top: Top = get_tree().root.get_node(\"Top\")

	var pickup_item: Node2D
	
	func _init(p_pickup_item: Node2D):
		pickup_item = p_pickup_item

	func _ready():
		player.request_state_forced(\"DROP\")
		await say(player, \"got abilities!\")
		player.request_state_normal()
		pickup_item.queue_free()

		player.inventory.hanging = true
		top.game_set(Top.SAVE_GOT_HANG, true)
		
		player.inventory.zoop = true
		top.game_set(Top.SAVE_GOT_ZOOP, true)
		
		top.game_save()
"

