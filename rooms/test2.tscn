[sub_resource type="GDScript" id="GDScript_vjuef"]
script/source = "extends Area2D

var original_pos: Vector2

func _on_trigger_button_triggered() -> void:
	var p: Player = get_parent().get_node(\"Player\")
	original_pos = global_position
	add_to_group(\"camera_target\")
	p.velocity.x = -1
	p.request_state_init()
	$AnimationPlayer.play(\"opening\")

func _on_opened() -> void:
	var p: Player = get_parent().get_node(\"Player\")
	p.request_state_normal()
	remove_from_group(\"camera_target\")
	queue_free()

func _camera_target() -> Vector2:
	return original_pos + Vector2(0, 30)
"

